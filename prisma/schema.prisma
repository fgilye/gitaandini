// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model HazardReport {
  id          Int      @id @default(autoincrement())
  reporter    String
  location    String
  description String
  severity    String
  status      String   @default("Reported")
  createdAt   DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Certificate {
  id           Int     @id @default(autoincrement())
  title        String
  issuer       String
  issueDate    String
  expiryDate   String
  credentialId String
  category     String
  imageName    String
}
